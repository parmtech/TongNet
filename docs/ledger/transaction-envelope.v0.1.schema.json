{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tongnet.invalid/spec/ledger/transaction-envelope-v0.1.schema.json",
  "title": "TongNet test-only transaction envelope v0.1",
  "description": "Proposal schema for localtest fixtures only. It does not select a production wire format, address scheme, cryptographic algorithm, or deadline clock.",
  "allOf": [
    { "$ref": "#/$defs/base_envelope" },
    {
      "oneOf": [
        { "properties": { "operation": { "const": "TEST_FAUCET" }, "payload": { "$ref": "#/$defs/test_faucet_payload" } } },
        { "properties": { "operation": { "const": "TRANSFER" }, "payload": { "$ref": "#/$defs/transfer_payload" } } },
        { "properties": { "operation": { "const": "LOCK" }, "payload": { "$ref": "#/$defs/lock_payload" } } },
        { "properties": { "operation": { "const": "CLAIM_REQUEST" }, "payload": { "$ref": "#/$defs/claim_request_payload" } } },
        { "properties": { "operation": { "const": "FINAL_ACCEPT" }, "payload": { "$ref": "#/$defs/final_accept_payload" } } },
        { "properties": { "operation": { "const": "SENDER_RECLAIM" }, "payload": { "$ref": "#/$defs/sender_reclaim_payload" } } },
        { "properties": { "operation": { "const": "RECOVERY_PAIR" }, "payload": { "$ref": "#/$defs/recovery_pair_payload" } } },
        { "properties": { "operation": { "const": "RECOVERY_RUN" }, "payload": { "$ref": "#/$defs/recovery_run_payload" } } }
      ]
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "amount_atomic_u128_decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "minLength": 1,
      "maxLength": 39,
      "description": "Test-model unsigned decimal integer; parser must reject values greater than u128::MAX."
    },
    "positive_amount_atomic_u128_decimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "minLength": 1,
      "maxLength": 39,
      "description": "Positive test-model amount; parser must reject values greater than u128::MAX."
    },
    "nonce_u64_decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "minLength": 1,
      "maxLength": 20,
      "description": "Test-model unsigned decimal nonce; parser must reject values greater than u64::MAX."
    },
    "base_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "chain_id", "protocol_version", "signer", "nonce", "operation", "payload", "authorizations", "validity"],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "chain_id": { "$ref": "#/$defs/identifier" },
        "protocol_version": { "type": "integer", "minimum": 1 },
        "signer": { "$ref": "#/$defs/identifier" },
        "nonce": { "$ref": "#/$defs/nonce_u64_decimal" },
        "operation": {
          "enum": ["TEST_FAUCET", "TRANSFER", "LOCK", "CLAIM_REQUEST", "FINAL_ACCEPT", "SENDER_RECLAIM", "RECOVERY_PAIR", "RECOVERY_RUN"]
        },
        "payload": { "type": "object" },
        "authorizations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/authorization" }
        },
        "validity": { "$ref": "#/$defs/validity_context" }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "signer", "scheme_id", "signature"],
      "properties": {
        "role": { "$ref": "#/$defs/identifier" },
        "signer": { "$ref": "#/$defs/identifier" },
        "scheme_id": { "$ref": "#/$defs/identifier" },
        "signature": { "type": "string", "minLength": 1, "contentEncoding": "base64" }
      }
    },
    "validity_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "not_before", "expires_at"],
      "properties": {
        "policy_id": { "$ref": "#/$defs/identifier" },
        "not_before": { "$ref": "#/$defs/identifier" },
        "expires_at": { "$ref": "#/$defs/identifier" }
      },
      "description": "Opaque values interpreted only by the named, versioned policy; production time origin and clock are unresolved."
    },
    "test_faucet_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["faucet_id", "recipient", "amount_atomic"],
      "properties": {
        "faucet_id": { "$ref": "#/$defs/identifier" },
        "recipient": { "$ref": "#/$defs/identifier" },
        "amount_atomic": { "$ref": "#/$defs/positive_amount_atomic_u128_decimal" }
      }
    },
    "transfer_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipient", "amount_atomic"],
      "properties": {
        "recipient": { "$ref": "#/$defs/identifier" },
        "amount_atomic": { "$ref": "#/$defs/positive_amount_atomic_u128_decimal" }
      }
    },
    "lock_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["escrow_id", "receiver", "amount_atomic"],
      "properties": {
        "escrow_id": { "$ref": "#/$defs/identifier" },
        "receiver": { "$ref": "#/$defs/identifier" },
        "amount_atomic": { "$ref": "#/$defs/positive_amount_atomic_u128_decimal" }
      }
    },
    "claim_request_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["escrow_id", "receiver"],
      "properties": {
        "escrow_id": { "$ref": "#/$defs/identifier" },
        "receiver": { "$ref": "#/$defs/identifier" }
      }
    },
    "final_accept_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["escrow_id", "claim_request_id", "receiver", "amount_atomic"],
      "properties": {
        "escrow_id": { "$ref": "#/$defs/identifier" },
        "claim_request_id": { "$ref": "#/$defs/identifier" },
        "receiver": { "$ref": "#/$defs/identifier" },
        "amount_atomic": { "$ref": "#/$defs/positive_amount_atomic_u128_decimal" }
      }
    },
    "sender_reclaim_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["escrow_id"],
      "properties": {
        "escrow_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "recovery_pair_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairing_request_id", "source", "destination"],
      "properties": {
        "pairing_request_id": { "$ref": "#/$defs/identifier" },
        "source": { "$ref": "#/$defs/identifier" },
        "destination": { "$ref": "#/$defs/identifier" }
      }
    },
    "recovery_run_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairing_id", "source", "destination"],
      "properties": {
        "pairing_id": { "$ref": "#/$defs/identifier" },
        "source": { "$ref": "#/$defs/identifier" },
        "destination": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
